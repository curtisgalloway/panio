"""Linux OCR helper using Tesseract. Mirrors the visionocr interface.

Reads a PNG from stdin (pass '-') or a file path, applies 2x upscale and
black padding (same preprocessing as visionocr for small console fonts),
then pipes to tesseract and prints the recognized text.

With --json, emits the v1 OCR envelope (see docs/dev/ocr.md) instead: engine
identity, source dimensions, joined text, and per-line text + confidence +
bbox. Bboxes are mapped back through the upscale and padding to SOURCE image
coordinates — the preprocessed image is a different size, and a box in its
coordinates would aim a crop or a hid click at the wrong place.

Requires: tesseract-ocr  (sudo apt-get install tesseract-ocr)
Optional: Pillow         (pip install Pillow) — used for preprocessing;
          without it, the raw PNG is passed directly to tesseract.
"""

import argparse
import io
import json
import os
import subprocess
import sys
import tempfile

# Resource limits shared with ocr/rapidocr, ocr/visionocr.swift and
# ocr/winocr/src/main.rs -- MAX_ENCODED_BYTES, MAX_DIMENSION and MAX_PIXELS
# must be identical across all four helpers (see docs/dev/ocr.md's "Resource
# limits" section). This helper upscales 2x during preprocessing, so
# MAX_DIMENSION/MAX_PIXELS are sized against that *working* (post-2x, before
# padding) size: exactly 2x a 4K capture (3840x2160) in each dimension, so
# any 4K frame passes with margin. The small fixed padding _preprocess adds
# on top is not part of the limit -- it is a constant ~20 px, negligible
# against an 8192px/33-megapixel budget.
MAX_ENCODED_BYTES = 64 * 1024 * 1024  # 64 MiB of encoded (PNG) input
MAX_DIMENSION = 8192  # px, per side, of the post-upscale (pre-pad) working image
MAX_PIXELS = 33_177_600  # 7680x4320 total px of the post-upscale (pre-pad) image

# _preprocess's own upscale/pad factors, pulled out so the dimension check
# below can predict the buffer _preprocess is about to allocate before it
# allocates it.
_UPSCALE = 2
_PAD = 10


def die(msg: str) -> "None":
    sys.stderr.write(f"linuxocr: {msg}\n")
    sys.exit(1)


def _read_bounded(stream, max_bytes: int) -> bytes:
    """Read at most ``max_bytes`` + 1 bytes from ``stream``, in chunks, and
    error if the input turns out to be longer than ``max_bytes``.

    Reading one byte past the cap (rather than stopping exactly at it) is
    what lets this tell "exactly at the limit" from "over the limit" apart
    without ever buffering more than a byte more than the limit allows.
    """
    chunks = []
    total = 0
    while total <= max_bytes:
        chunk = stream.read(min(1 << 20, max_bytes + 1 - total))
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
    data = b"".join(chunks)
    if len(data) > max_bytes:
        die(f"input is over {max_bytes} bytes (encoded-input limit)")
    return data


def _read_input(path: str) -> bytes:
    """Read the encoded image from ``path``, or from stdin when it is ``-``.

    Every way this can fail -- a path that does not exist, a directory, a
    permission denial, an I/O error part-way through -- is the same answer to
    the caller, and it is the one docs/dev/ocr.md promises: one line on
    stderr, non-zero exit. A bare `open()` raised `FileNotFoundError` as a
    traceback instead, which a caller parsing stderr cannot act on (#168).

    `_read_bounded`'s own over-the-cap failure goes through `die`, which
    raises `SystemExit` -- not an `OSError` -- so it passes through here with
    its own message intact.
    """
    try:
        if path == "-":
            return _read_bounded(sys.stdin.buffer, MAX_ENCODED_BYTES)
        with open(path, "rb") as f:
            return _read_bounded(f, MAX_ENCODED_BYTES)
    except OSError as e:
        die(f"cannot read {'stdin' if path == '-' else path}: {e}")


def _check_dimensions(w: int, h: int) -> None:
    """Reject dimensions before they drive an allocation.

    Called both on the source image's dimensions (from the PNG header, before
    Pillow ever opens it) and on the working size _preprocess is about to
    allocate (2x upscale + padding) -- same two limits either way. A
    ``w``/``h`` of 0 means the caller could not determine a size yet (e.g.
    `_png_size` failed to parse a header) and there is nothing to check.
    """
    if w <= 0 or h <= 0:
        return
    if w > MAX_DIMENSION or h > MAX_DIMENSION:
        die(f"image is {w}x{h}; exceeds the {MAX_DIMENSION}px-per-side limit")
    if w * h > MAX_PIXELS:
        die(f"image is {w}x{h} ({w * h} px); exceeds the {MAX_PIXELS}px limit")


def _preprocess(png: bytes) -> bytes:
    """2x upscale + black pad. Falls back to identity if Pillow is absent.

    The import is its own `try` so that only a *missing Pillow* takes the
    identity path. It used to wrap the decode as well, which meant a decode
    failure was reported as a traceback (`UnidentifiedImageError` for bytes
    that are no image at all, `OSError` for a truncated one) rather than the
    one-line stderr message docs/dev/ocr.md promises -- and an ImportError
    raised from inside Pillow, by a missing codec plugin, would have silently
    skipped preprocessing instead (#168).

    `_check_dimensions` raises `SystemExit`, which is not an `Exception`, so
    an over-limit image still fails with its own message rather than being
    relabelled a decode failure here.
    """
    try:
        from PIL import Image  # type: ignore
    except ImportError:
        return png  # No Pillow: hand tesseract the raw PNG, unscaled.

    try:
        img = Image.open(io.BytesIO(png))
        w, h = img.size
        # Belt-and-suspenders: main() already checked the header-derived
        # size before calling this, but only when `_png_size` could parse
        # one. Pillow's Image.open reads just the header too, so checking
        # again here (before .convert()/.resize() force a full decode)
        # catches whatever the header parse above missed, at no extra cost.
        _check_dimensions(w, h)
        _check_dimensions(w * _UPSCALE, h * _UPSCALE)
        img = img.convert("RGB")
        img = img.resize((w * _UPSCALE, h * _UPSCALE), Image.LANCZOS)
        padded = Image.new(
            "RGB", (w * _UPSCALE + _PAD * 2, h * _UPSCALE + _PAD * 2), (0, 0, 0)
        )
        padded.paste(img, (_PAD, _PAD))
        buf = io.BytesIO()
        padded.save(buf, "PNG")
        return buf.getvalue()
    except Exception as e:
        die(f"could not decode image: {e}")


def _png_size(png: bytes) -> "tuple[int, int]":
    """Width and height from the PNG IHDR, without needing Pillow.

    The envelope reports SOURCE dimensions, and they must be known even on the
    no-Pillow path where nothing decodes the image.
    """
    if len(png) < 24 or png[:8] != b"\x89PNG\r\n\x1a\n":
        return (0, 0)
    return (int.from_bytes(png[16:20], "big"), int.from_bytes(png[20:24], "big"))


def _one_line(text: str) -> str:
    """Collapse tesseract's stderr to a single line for `die()`.

    tesseract narrates: a version banner, per-language warnings, then the
    failure, each on its own line -- and the informative line is usually the
    first, not the last. So keep every non-empty line, joined, rather than
    picking one.
    """
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    return "; ".join(lines) if lines else "(nothing on stderr)"


def _tesseract(tmp: str, tsv: bool) -> str:
    """Run tesseract on ``tmp`` and return its stdout.

    Both ways the spawn can fail leave through `die()` -- one line on stderr,
    non-zero exit -- rather than as what they were before #179: an uncaught
    `FileNotFoundError` traceback when the binary is not installed, and
    tesseract's raw multi-line stderr forwarded verbatim when it exits
    non-zero. A caller parsing stderr (hdmicap's /ocr runs this helper as a
    child process) can act on neither. A missing tesseract is an ordinary
    first-run state on a control host -- it is a system package the panio
    .deb only Recommends -- so the message names the package that provides it.
    """
    args = ["tesseract", tmp, "stdout", "--psm", "6", "--oem", "1"]
    if tsv:
        args.append("tsv")
    try:
        result = subprocess.run(args, capture_output=True, text=True)
    except FileNotFoundError:
        die("tesseract not found on PATH (install it: apt-get install tesseract-ocr)")
    except OSError as e:
        die(f"could not run tesseract: {e.strerror or e}")
    if result.returncode != 0:
        die(f"tesseract exited {result.returncode}: {_one_line(result.stderr)}")
    return result.stdout


def _clip_to_source(
    x0: float,
    y0: float,
    x1: float,
    y1: float,
    scale: int,
    pad: int,
    src_w: int,
    src_h: int,
) -> "tuple[int, int, int, int]":
    """Map a processed-space box to source coordinates and clip it there.

    ``(x0, y0)``-``(x1, y1)`` is a box in the preprocessed (upscaled + padded)
    image. Both corners are mapped independently through the inverse of that
    preprocessing (undo the padding, then the upscale) and rounded, then the
    result is intersected with ``[0, src_w] x [0, src_h]`` so the reported box
    never extends past the source frame — a box whose recognition rectangle
    crosses an edge shrinks on that side instead of reporting a size measured
    in the padding. A box that lands entirely outside the source (possible
    only for garbage input) clips to zero size rather than negative.

    ``src_w``/``src_h`` may be ``0`` (the PNG header could not be parsed) — the
    near edge is still clamped to 0 in that case, but the far edge is left
    unclipped, since the true source extent isn't known.

    Returns ``(x, y, w, h)`` with ``w, h >= 0``.
    """

    def to_source(v: float) -> int:
        return round((v - pad) / scale)

    sx0, sy0 = to_source(x0), to_source(y0)
    sx1, sy1 = to_source(x1), to_source(y1)

    x = min(max(0, sx0), src_w) if src_w else max(0, sx0)
    y = min(max(0, sy0), src_h) if src_h else max(0, sy0)
    x1c = min(sx1, src_w) if src_w else sx1
    y1c = min(sy1, src_h) if src_h else sy1
    x1c = max(x1c, x)
    y1c = max(y1c, y)

    return x, y, x1c - x, y1c - y


def _lines_from_tsv(tsv: str, scale: int, pad: int, src_w: int, src_h: int) -> list:
    """Group tesseract's per-word TSV rows into lines, in source coordinates.

    Tesseract emits one row per word with a (block, paragraph, line) key; the
    line's box is the union of its words' and its confidence their mean.
    Confidence is 0-100 here and -1 for "no text recognized" — the latter is
    dropped rather than reported as 0.0, which would read as certainty that the
    line is wrong rather than an absence of evidence.
    """
    rows = tsv.splitlines()
    if not rows:
        return []
    header = rows[0].split("\t")
    try:
        idx = {k: header.index(k) for k in
               ("block_num", "par_num", "line_num", "left", "top",
                "width", "height", "conf", "text")}
    except ValueError:
        return []

    grouped: dict = {}
    order: list = []
    for row in rows[1:]:
        f = row.split("\t")
        if len(f) <= idx["text"]:
            continue
        text = f[idx["text"]].strip()
        if not text:
            continue
        try:
            conf = float(f[idx["conf"]])
            left, top = int(f[idx["left"]]), int(f[idx["top"]])
            wid, hgt = int(f[idx["width"]]), int(f[idx["height"]])
        except ValueError:
            continue
        key = (f[idx["block_num"]], f[idx["par_num"]], f[idx["line_num"]])
        if key not in grouped:
            grouped[key] = {"words": [], "confs": [],
                            "x0": left, "y0": top,
                            "x1": left + wid, "y1": top + hgt}
            order.append(key)
        g = grouped[key]
        g["words"].append(text)
        if conf >= 0:
            g["confs"].append(conf / 100.0)
        g["x0"] = min(g["x0"], left)
        g["y0"] = min(g["y0"], top)
        g["x1"] = max(g["x1"], left + wid)
        g["y1"] = max(g["y1"], top + hgt)

    out = []
    for key in order:
        g = grouped[key]
        x, y, w, h = _clip_to_source(
            g["x0"], g["y0"], g["x1"], g["y1"], scale, pad, src_w, src_h
        )
        line = {"text": " ".join(g["words"]), "bbox": [x, y, w, h]}
        if g["confs"]:
            line["confidence"] = round(sum(g["confs"]) / len(g["confs"]), 4)
        out.append(line)
    return out


def main() -> None:
    ap = argparse.ArgumentParser(
        description="OCR a PNG image using Tesseract (Linux visionocr replacement)."
    )
    ap.add_argument("input", nargs="?", default="-", help="PNG file path, or - for stdin")
    ap.add_argument(
        "--json",
        action="store_true",
        help="Emit the v1 OCR envelope (docs/dev/ocr.md) instead of plain text",
    )
    args = ap.parse_args()

    png = _read_input(args.input)

    src_w, src_h = _png_size(png)
    if src_w and src_h:
        # Inspect the header before _preprocess ever opens the image, so an
        # oversized claim is rejected before Pillow decodes anything.
        _check_dimensions(src_w, src_h)
        _check_dimensions(src_w * _UPSCALE, src_h * _UPSCALE)
    processed = _preprocess(png)
    # _preprocess is identity when Pillow is missing, and then no mapping back
    # is needed. Detect that rather than assuming, so the bboxes stay correct
    # on a host without Pillow.
    scaled = processed is not png
    scale, pad = (2, 10) if scaled else (1, 0)

    with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as tf:
        tf.write(processed)
        tmp = tf.name

    try:
        if not args.json:
            sys.stdout.write(_tesseract(tmp, tsv=False))
            return
        lines = _lines_from_tsv(_tesseract(tmp, tsv=True), scale, pad, src_w, src_h)
        envelope = {
            "version": 1,
            "engine": "linuxocr",
            "engine_detail": "Tesseract --psm 6 --oem 1"
            + ("" if scaled else " (no Pillow: unscaled)"),
            "width": src_w,
            "height": src_h,
            "text": "\n".join(ln["text"] for ln in lines),
            "lines": lines,
        }
        json.dump(envelope, sys.stdout, indent=2)
        sys.stdout.write("\n")
    finally:
        os.unlink(tmp)


if __name__ == "__main__":
    main()
