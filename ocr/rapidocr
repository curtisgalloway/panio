"""Linux GUI-mode OCR helper: PP-OCRv6 via RapidOCR, on ONNX Runtime.

The third OCR helper, and the only one that exists because of a measurement
rather than a platform. On a Pi 5 control host, over the benchmark set in
evals/ocr:

    GUI screens   rapidocr 0.083 token-recall error   tesseract 0.312
    text screens  tesseract 0.019 CER                 rapidocr 0.025

So this is the **GUI** engine on Linux and `linuxocr` stays the text one. It is
about 4x better where anti-aliased UI text is involved and slightly worse on
console text, at roughly 2.5x the latency (~4.2 s vs ~1.7 s per 720p frame).

Two things that argument rests on, worth keeping in view if it is revisited:

- The latency is affordable because OCR is not in any polling loop. Change
  detection uses the frame hash (`/status`, `--changed-since`); this runs only
  when something explicitly asks what the screen says.
- Tesseract's GUI failure mode is *silent omission* — well-formed text with
  whole rows missing, and no confidence signal, because it is confident about
  what it did read. That is why the obvious "run tesseract, fall back on low
  confidence" hybrid cannot work, and why the slower engine wins here.

**No preprocessing.** The benchmark swept upscaling, inversion and binarisation:
every variant was slower than `raw` and none was more accurate. Unlike
`visionocr` and `linuxocr`, which both upscale internally, this helper hands the
frame over untouched.

Requires the `rapidocr` and `onnxruntime` packages. `panio setup` builds a
dedicated venv beside this script (see `_reexec_into_venv`), because Pi OS is
PEP 668-managed and a system-wide install is refused.
"""

from __future__ import annotations

import argparse
import io
import json
import os
import sys
from pathlib import Path

VENV_NAMES = ("ocr-venv",)


def _reexec_into_venv() -> None:
    """Re-exec under the sibling venv's interpreter whenever one exists.

    The helper is invoked by hdmicap as a bare executable, so it cannot rely on
    a virtualenv being active. `panio setup` creates `ocr-venv/` next to this
    script, and if that interpreter is there this hands over to it -- without
    first asking whether the ambient interpreter could have served, which the
    docstring used to claim it did (#168).

    Unconditional hand-over is the behavior to keep, so this corrects the
    docstring rather than adding the check it described. `panio setup`
    builds that venv for this script alone and curates it: it pins
    `rapidocr>=3,<4`, then uninstalls the `opencv-python` rapidocr pulls in
    and force-installs `opencv-python-headless` over it, because the full
    build needs `libGL.so.1`, which a headless Pi OS does not have
    (cli/src/setup.rs). An ambient interpreter that merely satisfies
    `import rapidocr` has none of that curation, and preferring it would make
    which engine runs -- and whether it runs at all -- depend on what else is
    installed on the control host. When the venv exists it is the answer;
    when it does not, the ambient interpreter is tried and main()'s import
    error names the fix.
    """
    if os.environ.get("PANIO_RAPIDOCR_REEXEC"):
        return  # Already tried; do not loop.
    here = Path(__file__).resolve().parent
    for name in VENV_NAMES:
        python = here / name / "bin" / "python3"
        if python.is_file():
            os.environ["PANIO_RAPIDOCR_REEXEC"] = "1"
            os.execv(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]])


def die(msg: str) -> "None":
    sys.stderr.write(f"rapidocr: {msg}\n")
    raise SystemExit(1)


# Resource limits shared with ocr/linuxocr, ocr/visionocr.swift and
# ocr/winocr/src/main.rs -- MAX_ENCODED_BYTES, MAX_DIMENSION and MAX_PIXELS
# must be identical across all four helpers (see docs/dev/ocr.md's "Resource
# limits" section). This helper does no upscaling (see the module docstring),
# so these apply directly to the source image.
MAX_ENCODED_BYTES = 64 * 1024 * 1024  # 64 MiB of encoded (PNG) input
MAX_DIMENSION = 8192  # px, per side
MAX_PIXELS = 33_177_600  # 7680x4320 total px -- 2x a 4K capture, with margin


_PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"


def _png_size(png: bytes) -> "tuple[int, int]":
    """Width and height from the PNG IHDR, without decoding.

    Mirrors ocr/linuxocr's copy of the same check -- kept as a separate copy
    rather than a shared import because these are standalone scripts, not a
    package.
    """
    if len(png) < 24 or png[:8] != _PNG_SIGNATURE:
        return (0, 0)
    return (int.from_bytes(png[16:20], "big"), int.from_bytes(png[20:24], "big"))


def _require_png(png: bytes) -> "tuple[int, int]":
    """Size a PNG from its header, or die if the input is not a PNG.

    A pre-decode dimension check can only protect the decode it runs before,
    and `_png_size` can only size a PNG. `cv2.imdecode` accepts JPEG, BMP and
    WebP as well, so guarding the check with "did the header parse?" silently
    skipped it for every one of those: a small JPEG whose SOF declared
    20000x20000 passed the byte cap, parsed as no PNG at all, and was
    rasterized in full before the post-decode backstop -- which runs after the
    allocation it exists to prevent -- could see it (issue #167).

    Refusing non-PNG outright, rather than teaching this helper a second
    header format, is what the contract already says: docs/dev/ocr.md's input
    is "a PNG on stdin (`-`) or a path argument", hdmicap pipes the output of
    its own PNG encoder, and nothing else in the tree feeds this helper.
    """
    if png[:8] != _PNG_SIGNATURE:
        die("input is not a PNG (this helper reads a PNG on stdin or a path)")
    w, h = _png_size(png)
    if w <= 0 or h <= 0:
        die("PNG header is truncated or declares an empty image")
    return (w, h)


def _check_dimensions(w: int, h: int) -> None:
    """Reject dimensions before they drive a decode.

    A ``w``/``h`` of 0 means the caller could not determine a size yet (e.g.
    `_png_size` failed to parse a header) and there is nothing to check.
    """
    if w <= 0 or h <= 0:
        return
    if w > MAX_DIMENSION or h > MAX_DIMENSION:
        die(f"image is {w}x{h}; exceeds the {MAX_DIMENSION}px-per-side limit")
    if w * h > MAX_PIXELS:
        die(f"image is {w}x{h} ({w * h} px); exceeds the {MAX_PIXELS}px limit")


def _read_bounded(stream, max_bytes: int) -> bytes:
    """Read at most ``max_bytes`` + 1 bytes from ``stream``, in chunks, and
    error if the input turns out to be longer than ``max_bytes``. See
    ocr/linuxocr's copy of this function for why one byte past the cap.
    """
    chunks = []
    total = 0
    while total <= max_bytes:
        chunk = stream.read(min(1 << 20, max_bytes + 1 - total))
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
    data = b"".join(chunks)
    if len(data) > max_bytes:
        die(f"input is over {max_bytes} bytes (encoded-input limit)")
    return data


def _read_input(path: str) -> bytes:
    """Read the encoded image from ``path``, or from stdin when it is ``-``.

    Every way this can fail -- a path that does not exist, a directory, a
    permission denial, an I/O error part-way through -- is the same answer to
    the caller, and it is the one docs/dev/ocr.md promises: one line on
    stderr, non-zero exit. A bare `open()` raised `FileNotFoundError` as a
    traceback instead (#168). Mirrors ocr/linuxocr's copy, for the same
    reason `_read_bounded` is copied rather than shared.
    """
    try:
        if path == "-":
            return _read_bounded(sys.stdin.buffer, MAX_ENCODED_BYTES)
        with open(path, "rb") as f:
            return _read_bounded(f, MAX_ENCODED_BYTES)
    except OSError as e:
        die(f"cannot read {'stdin' if path == '-' else path}: {e}")


def main() -> None:
    ap = argparse.ArgumentParser(
        description="OCR a PNG using PP-OCRv6 via RapidOCR (Linux GUI-mode helper)."
    )
    ap.add_argument("input", nargs="?", default="-", help="PNG file path, or - for stdin")
    ap.add_argument(
        "--json",
        action="store_true",
        help="Emit the v1 OCR envelope (docs/dev/ocr.md) instead of plain text",
    )
    args = ap.parse_args()

    try:
        import numpy as np
        from rapidocr import RapidOCR
        import cv2
    except ImportError as e:
        die(
            f"{e}. Install the OCR venv with `panio setup`, or "
            "pip install 'rapidocr>=3,<4' onnxruntime opencv-python-headless"
        )

    png = _read_input(args.input)
    if not png:
        die("no image data")

    # Inspect the header before cv2.imdecode ever rasterizes the image, so an
    # oversized claim is rejected before OpenCV decodes anything. Input that
    # is not a PNG is refused here rather than measured: this helper cannot
    # size it, and cv2 would decode it anyway -- see `_require_png`.
    src_w, src_h = _require_png(png)
    _check_dimensions(src_w, src_h)

    img = cv2.imdecode(np.frombuffer(png, np.uint8), cv2.IMREAD_COLOR)
    if img is None:
        die("could not decode image")
    height, width = img.shape[:2]
    # Backstop: the check above ran on what the IHDR claimed, this one runs on
    # what OpenCV actually produced. The decode already happened, but the OCR
    # engine below has not run yet.
    _check_dimensions(width, height)

    # Four threads matches a Pi's core count. The key is nested under the
    # engine, not Global — RapidOCR validates keys strictly and raises on an
    # unknown one, so a guess fails loudly rather than running single-threaded.
    engine = RapidOCR(params={"EngineConfig.onnxruntime.intra_op_num_threads": 4})
    out = engine(img)

    # `x or []` is wrong here: these are numpy arrays, whose __bool__ raises
    # "truth value of an array with more than one element is ambiguous".
    def as_list(attr: str) -> list:
        v = getattr(out, attr, None)
        return [] if v is None else list(v)

    boxes, txts, scores = as_list("boxes"), as_list("txts"), as_list("scores")

    lines = []
    for i, txt in enumerate(txts):
        line = {"text": str(txt)}
        if i < len(scores):
            line["confidence"] = round(float(scores[i]), 4)
        if i < len(boxes) and boxes[i] is not None:
            pts = np.asarray(boxes[i]).reshape(-1, 2)
            x0, y0 = int(pts[:, 0].min()), int(pts[:, 1].min())
            x1, y1 = int(pts[:, 0].max()), int(pts[:, 1].max())
            # Source coordinates, origin top-left: this helper does no
            # preprocessing, so there is no transform to undo.
            line["bbox"] = [x0, y0, x1 - x0, y1 - y0]
        lines.append(line)

    if not args.json:
        for line in lines:
            print(line["text"])
        return

    json.dump(
        {
            "version": 1,
            "engine": "rapidocr",
            "engine_detail": "PP-OCRv6 via RapidOCR on ONNX Runtime",
            "width": width,
            "height": height,
            "text": "\n".join(line["text"] for line in lines),
            "lines": lines,
        },
        sys.stdout,
        indent=2,
    )
    sys.stdout.write("\n")


if __name__ == "__main__":
    _reexec_into_venv()
    main()
