#cloud-config
# SPDX-FileCopyrightText: 2026 Curtis Galloway
# SPDX-License-Identifier: Apache-2.0
#
# panio control-host seed — pi-sd flavor, Raspberry Pi OS Trixie Lite arm64.
# Drop this on the FAT `bootfs` partition of a freshly flashed card as
# `user-data`, alongside `meta-data`, `network-config`, and an empty `ssh`
# file. See ../README.md for the procedure and the placeholder list.
#
# `#cloud-config` MUST stay the first line — cloud-init sniffs it to decide
# the payload type, and anything above it (including this header) would make
# the file be ignored.
#
# Five angle-bracket placeholders below must be replaced before flashing.
# They are listed in ../README.md, and the check that proves none survived is
# there too. Run `panio skill control-host` for the whole procedure.

hostname: <hostname>
manage_etc_hosts: true

users:
  - name: <user>
    gecos: <full-name>
    # dialout: serial consoles. video: HDMI capture devices. gpio/plugdev:
    # USB helper hardware. The .deb deliberately does not manage group
    # membership (it is a per-user concern), so the seed does it declaratively
    # and `panio setup` finds nothing left to fix on first login.
    groups: [adm, sudo, dialout, video, gpio, plugdev]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - <ssh-public-key>

ssh_pwauth: false

# Pi OS downstream option per the cloud-init announcement; did NOT enable sshd
# on the 2026-06-18 Lite image in testing (it is not in upstream
# cc_raspberry_pi, and was a silent no-op here). Kept for documentation; the
# bootcmd below and the empty `ssh` flag file on bootfs are the mechanisms
# that actually work. Ship all three.
enable_ssh: true

# Runs EVERY boot, before the per-instance stages — so it is immune to
# cloud-init's instance-id caching. Enable only, NEVER `--now`: bootcmd runs
# in the pre-network local stage, and starting ssh.service there deadlocks the
# boot (ssh waits for the network, the network waits for cloud-init-local,
# which is blocked in this very command — observed hang, recovered only by
# power-cut). The enable symlink is instant; sshd then starts normally at
# multi-user.
bootcmd:
  - [ sh, -c, "systemctl enable ssh || true" ]

package_update: true
packages:
  # tesseract-ocr is only a Recommends of the .deb; be explicit rather than
  # depend on apt's install-recommends default surviving.
  - tesseract-ocr
  - curl
  - avahi-daemon
  - openssh-server

# The .deb carries the CLI, every helper daemon, linuxocr, and the agent
# skills, so this is the whole panio install. arm64 is hardcoded because
# this flavor is Pi-only and the package is not built for armhf.
runcmd:
  - curl -fsSL -o /tmp/panio.deb https://github.com/curtisgalloway/panio/releases/download/v<version>/panio_<version>_arm64.deb
  - apt-get install -y /tmp/panio.deb
  - rm -f /tmp/panio.deb
