#
# panio control-host seed — pi-sd flavor. Goes on the FAT `bootfs`
# partition as `meta-data`. Derived from the stock Raspberry Pi OS file.

# Datasource mode "local": user-data is acted upon before the network comes
# up, which is what we want — everything about this datasource is on the card.
dsmode: local

# cloud-init caches this value on the rootfs and compares it on every boot. An
# unchanged id means "same instance, already provisioned", so the user,
# package, and runcmd stages are SKIPPED.
#
# Re-seeding a card that has already booted therefore takes TWO edits: change
# `user-data`, AND bump this id. Editing user-data alone looks like it did
# nothing.
instance_id: panio-seed-1
